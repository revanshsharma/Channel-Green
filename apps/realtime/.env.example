# Channel Green realtime server. Copy to .env (never commit .env).
# Everything is optional for local play: with nothing set the server runs in
# "guest + memory" mode and voice/video are reported as disabled.

# Port to listen on (Fly/Render/Railway usually inject PORT for you)
PORT=4001

# development | production. In production SERVER_SECRET is required.
NODE_ENV=development

# Long random string (32+ chars). Signs guest tokens and derives anonymous player ids.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SERVER_SECRET=

# Comma-separated browser origins allowed to connect. Add your site here.
ALLOWED_ORIGINS=http://localhost:3000

# Set true when running behind a proxy/load balancer that sets X-Forwarded-For (Fly, Render, Railway, nginx)
TRUST_PROXY=false

# --- Supabase (optional): real accounts, saved avatars, persistent blocks/reports/confessions ---
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # server only! never expose to the browser
# SUPABASE_JWT_SECRET=            # legacy projects (HS256). Newer projects are verified via the public JWKS and need no secret.
# Supabase user ids (UUIDs) that act as moderators ("guides"). Comma-separated.
# MODERATOR_USER_IDS=

# --- LiveKit (optional): voice and video ---
# LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Safety tuning (optional) ---
# Extra words to block in chat/confessions/names, comma-separated (on top of the built-in starter list)
# EXTRA_BLOCKED_TERMS=
# MAX_CONNECTIONS_PER_IP=8
# CONFESSION_TTL_DAYS=7
