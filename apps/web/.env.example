# Channel Green web app. Copy to .env.local (never commit it).
# Nothing here is a secret: NEXT_PUBLIC_* values are visible in the browser by design.

# Where the realtime server lives. Local default is http://localhost:4001 when this is empty.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001

# Public site URL (used for links and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase sign-in. Leave empty to play as a guest.
# (The anon key is public by design; the service-role key never belongs in this app.)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
